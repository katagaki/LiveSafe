            "state": "translated",
            "value": "関東"
          }
        }
      }
    },
    "Keep away from swollen rivers, flooded roads and underpasses.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "増水した川、冠水した道路やアンダーパスには近づかないでください。"
          }
        }
      }
    },
    "Kyoshin Monitor (NIED)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強震モニタ（防災科研）"
          }
        }
      }
    },
    "Kyushu": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "九州"
          }
        }
      }
    },
    "Landslide": {
      "localizations": {
        "ja": {
