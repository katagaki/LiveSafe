    "Slope Failure, Debris Flow and Landslide": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "崖崩れ、土石流及び地滑り"
          }
        }
      }
    },
    "Stay away until every warning and advisory is lifted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警報や注意報がすべて解除されるまで戻らないでください。"
          }
        }
      }
    },
    "Steep Slope Failure (Warning Zone)": {
      "localizations": {
